foreach(case IN ITEMS legacy modern partial missing)
  file(GLOB manifests "${build_dir}/objects-${case}-*.txt")
  set(objects "")
  foreach(manifest IN LISTS manifests)
    file(STRINGS "${manifest}" candidates)
    set(complete TRUE)
    foreach(object IN LISTS candidates)
      if(NOT EXISTS "${object}")
        set(complete FALSE)
      endif()
    endforeach()
    if(complete)
      set(objects "${candidates}")
      break()
    endif()
  endforeach()
  list(LENGTH objects count)
  if(NOT count EQUAL 2)
    message(FATAL_ERROR "${case}: expected two compiled objects, got ${objects}")
  endif()
  foreach(object IN LISTS objects)
    file(STRINGS "${object}" versions REGEX "INFO:compiler_version\\[")
    if(case STREQUAL "missing")
      if(versions)
        message(FATAL_ERROR "${object}: unexpected version: ${versions}")
      endif()
    else()
      if(case STREQUAL "legacy")
        set(expected "5\\.9\\.9\\.0")
      elseif(case STREQUAL "modern")
        set(expected "0*10\\.0*2\\.0*3\\.0*4")
      else()
        set(expected "8\\.1\\.0\\.0")
      endif()
      if(NOT versions MATCHES "INFO:compiler_version\\[${expected}\\]")
        message(FATAL_ERROR "${object}: unexpected version: ${versions}")
      endif()
    endif()
  endforeach()
endforeach()
