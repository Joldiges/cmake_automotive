function(build)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build_dir}" --config Debug
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Build failed (${result}):\n${output}\n${error}")
  endif()
endfunction()

function(snapshot prefix)
  foreach(object IN LISTS objects)
    file(SIZE "${object}" size)
    if(size EQUAL 0)
      message(FATAL_ERROR "Empty object: ${object}")
    endif()
    file(SHA256 "${object}" hash)
    file(TIMESTAMP "${object}" timestamp "%s" UTC)
    string(MD5 key "${object}")
    set("${prefix}_${key}" "${timestamp}:${hash}" PARENT_SCOPE)
  endforeach()
endfunction()

build()
file(STRINGS "${build_dir}/objects-Debug.txt" objects)
list(LENGTH objects count)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Expected three objects, got ${objects}")
endif()
snapshot(before)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
build()
snapshot(after)
foreach(object IN LISTS objects)
  string(MD5 key "${object}")
  if(NOT "${before_${key}}" STREQUAL "${after_${key}}")
    message(FATAL_ERROR "Unchanged build recompiled ${object}")
  endif()
endforeach()

foreach(header IN ITEMS direct indirect)
  snapshot(before)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
  if(header STREQUAL "direct")
    file(WRITE "${build_dir}/include/direct.h"
      "#include <indirect.h>\n#define DIRECT_VALUE 11\n")
  else()
    file(WRITE "${build_dir}/include/indirect.h" "#define INDIRECT_VALUE 21\n")
  endif()
  build()
  snapshot(after)
  foreach(object IN LISTS objects)
    string(MD5 key "${object}")
    if(object MATCHES "unrelated")
      if(NOT "${before_${key}}" STREQUAL "${after_${key}}")
        message(FATAL_ERROR "${header}.h rebuilt unrelated object ${object}")
      endif()
    elseif("${before_${key}}" STREQUAL "${after_${key}}")
      message(FATAL_ERROR "${header}.h did not rebuild consumer ${object}")
    endif()
  endforeach()
endforeach()

snapshot(before)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
build()
snapshot(after)
foreach(object IN LISTS objects)
  string(MD5 key "${object}")
  if(NOT "${before_${key}}" STREQUAL "${after_${key}}")
    message(FATAL_ERROR "Final unchanged build recompiled ${object}")
  endif()
endforeach()
