set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT DEFINED ENV{DIAB_BIN} OR NOT DEFINED ENV{DIAB_TARGET})
  message(FATAL_ERROR "Set DIAB_BIN to the compiler bin directory and DIAB_TARGET to its -t target")
endif()

find_program(CMAKE_C_COMPILER NAMES dcc HINTS "$ENV{DIAB_BIN}" NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES dplus HINTS "$ENV{DIAB_BIN}" NO_DEFAULT_PATH REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
foreach(lang IN ITEMS C CXX ASM)
  set(CMAKE_${lang}_FLAGS_INIT "-t$ENV{DIAB_TARGET} -Xlicense-wait")
endforeach()
